# ============================================================
# GENEL
# ============================================================
NODE_ENV=development

# JWT — süresiz token (mobil uygulama için)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# ============================================================
# VERİTABANI — PostgreSQL (tüm Prisma servisleri için ortak kullanıcı)
# ============================================================
POSTGRES_USER=cimbil
POSTGRES_PASSWORD=cimbil_secret_password

# Servis bazlı bağlantı URL'leri (docker-compose otomatik oluşturur,
# lokal geliştirme için elle set et)
USER_DATABASE_URL=postgresql://cimbil:cimbil_secret_password@localhost:5432/user_db
NUTRITION_DATABASE_URL=postgresql://cimbil:cimbil_secret_password@localhost:5433/nutrition_db
HEALTH_DATABASE_URL=postgresql://cimbil:cimbil_secret_password@localhost:5434/health_db
SUBSCRIPTION_DATABASE_URL=postgresql://cimbil:cimbil_secret_password@localhost:5435/subscription_db

# ============================================================
# VERİTABANI — MongoDB
# ============================================================
MONGO_USER=cimbil
MONGO_PASSWORD=cimbil_mongo_password

# Servis bazlı URI'lar (lokal geliştirme)
FOOD_MONGODB_URI=mongodb://cimbil:cimbil_mongo_password@localhost:27017/food_db?authSource=admin
RECIPE_MONGODB_URI=mongodb://cimbil:cimbil_mongo_password@localhost:27018/recipe_db?authSource=admin

# ============================================================
# NODEMAILER / SMTP
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Cimbil <noreply@cimbil.app>"

# ============================================================
# İYZİCO — Ödeme Entegrasyonu
# ============================================================
# Sandbox (geliştirme)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox.iyzipay.com
IYZICO_WEBHOOK_SECRET=

# Production için:
# IYZICO_BASE_URL=https://api.iyzipay.com

# ============================================================
# PLAN FİYATLARI (TRY)
# ============================================================
PRO_MONTHLY_PRICE=99.90
PRO_YEARLY_PRICE=899.90
PRO_YEARLY_DISCOUNT=25

PREMIUM_MONTHLY_PRICE=199.90
PREMIUM_YEARLY_PRICE=1799.90
PREMIUM_YEARLY_DISCOUNT=25

# ============================================================
# SERVİS PORT'LARI (opsiyonel — docker-compose override için)
# ============================================================
GATEWAY_PORT=8080
USER_SERVICE_PORT=3001
NUTRITION_SERVICE_PORT=3002
RECIPE_SERVICE_PORT=3003
HEALTH_SERVICE_PORT=3004
AI_SERVICE_PORT=3005
SUBSCRIPTION_SERVICE_PORT=3006
